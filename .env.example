# EdgeTrack Environment Configuration

PROJECT_NAME=EdgeTrack
VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ONNX Runtime Inference Parameters
MODEL_PATH=models/yolov8n.onnx
INT8_MODEL_PATH=models/yolov8n_int8.onnx
USE_INT8=false
INPUT_WIDTH=640
INPUT_HEIGHT=640
CONF_THRESHOLD=0.25
NMS_IOU_THRESHOLD=0.45
ORT_NUM_THREADS=4
ORT_INTER_OP_THREADS=1

# ByteTrack Tracking Parameters
TRACK_HIGH_THRESH=0.5
TRACK_LOW_THRESH=0.1
NEW_TRACK_THRESH=0.6
MATCH_THRESH=0.8
MATCH_THRESH_SECOND=0.5
MATCH_THRESH_UNCONFIRMED=0.7
MAX_LOST_FRAMES=30
MIN_CONSECUTIVE_FRAMES=2

